{
  "version": 1,
  "stepsets": [
    {
      "id": "course_b_3_l1_steps",
      "course_id": "course_b_3",
      "lesson_id": "course_b_3_l1",
      "hints": [
        "После старта не повторяй знакомство — учи местоимения."
      ],
      "items": [
        {
          "kind": "tip",
          "text": "Выбери одно «я» (пхом или чхан) и держись его — тайцам важна стабильность.",
          "order": 1
        },
        {
          "order": 2,
          "kind": "word",
          "ru": "Я мужчина",
          "thai": "ผม",
          "phonetic": "пхом→",
          "tip": "«Я» для мужчин. Выбери одно «я» и держись его."
        },
        {
          "order": 3,
          "kind": "word",
          "ru": "Я женщина",
          "thai": "ฉัน",
          "phonetic": "чхан→",
          "tip": "«Я» нейтрально/женственно. Ок большинству ситуаций."
        },
        {
          "order": 4,
          "kind": "word",
          "ru": "Ты вы",
          "thai": "คุณ",
          "phonetic": "кун→",
          "tip": "Вежливое ты/вы. Безопасно с незнакомцами."
        },
        {
          "order": 5,
          "kind": "word",
          "ru": "Мы",
          "thai": "เรา",
          "phonetic": "рао→",
          "tip": "Мы. Часто включают слушателя — звучит теплее."
        },
        {
          "order": 6,
          "kind": "phrase",
          "ru": "Это мой друг",
          "thai": "นี่เพื่อนของฉัน",
          "phonetic": "ни→ пхыан→ кхонг→ чхан→",
          "tip": "Повтори 2 раза: медленно → как местный."
        },
        {
          "order": 7,
          "kind": "phrase",
          "ru": "Это ты?",
          "thai": "คุณใช่ไหม",
          "phonetic": "кун→ чай→ май↗",
          "tip": "Вопрос: в конце тон чуть [[вверх]]."
        }
      ]
    },
    {
      "id": "course_b_3_l2_steps",
      "course_id": "course_b_3",
      "lesson_id": "course_b_3_l2",
      "hints": [
        "Кхау — он/она чаще всего."
      ],
      "items": [
        {
          "kind": "tip",
          "text": "Тхё — мягкое «она» между своими. С незнакомкой безопаснее кхау / кун.",
          "order": 1
        },
        {
          "order": 2,
          "kind": "word",
          "ru": "Он она",
          "thai": "เขา",
          "phonetic": "кхау→",
          "tip": "Он/она в одном слове. Контекст подскажет пол."
        },
        {
          "order": 3,
          "kind": "phrase",
          "ru": "Его зовут …",
          "thai": "เขาชื่อ …",
          "phonetic": "кхау→ чыу→ …→",
          "tip": "Закрой RU и вспомни только по ситуации."
        },
        {
          "order": 4,
          "kind": "phrase",
          "ru": "Он таец",
          "thai": "เขาเป็นคนไทย",
          "phonetic": "кхау→ пэн→ кон→ тай→",
          "tip": "Произнеси со стрелками, потом быстрее."
        },
        {
          "order": 5,
          "kind": "phrase",
          "ru": "Она моя подруга",
          "thai": "เธอเป็นเพื่อนฉัน",
          "phonetic": "тхё→ пэн→ пхыан→ чхан→",
          "tip": "«Она моя подруга» — повтори 2 раза: медленно → как местный."
        },
        {
          "order": 6,
          "kind": "phrase",
          "ru": "Они",
          "thai": "พวกเขา",
          "phonetic": "пхуак→ кхау→",
          "tip": "«Они» — произнеси со стрелками, потом быстрее."
        },
        {
          "order": 7,
          "kind": "phrase",
          "ru": "Они друзья",
          "thai": "พวกเขาเป็นเพื่อน",
          "phonetic": "пхуак→ кхау→ пэн→ пхыан→",
          "tip": "«Они друзья» — запомни мелодией целиком, не по слогам."
        },
        {
          "order": 8,
          "kind": "casual",
          "ru": "Он классный",
          "thai": "เขาน่ารัก",
          "phonetic": "кхау→ на→ рак↘",
          "tip": "Casual: ок с друзьями, с незнакомцем — вежливее."
        },
        {
          "order": 9,
          "kind": "phrase",
          "ru": "Она работает здесь",
          "thai": "เธอทำงานที่นี่",
          "phonetic": "тхё→ там→ нгаан→ ти→ ни↘",
          "tip": "Запомни мелодией целиком, не по слогам."
        }
      ]
    },
    {
      "id": "course_b_3_l3_steps",
      "course_id": "course_b_3",
      "lesson_id": "course_b_3_l3",
      "hints": [
        "Семья в Тае — святое. Говори с теплом."
      ],
      "items": [
        {
          "kind": "tip",
          "text": "Рассказ про семью сближает быстрее small talk про погоду.",
          "order": 1
        },
        {
          "order": 2,
          "kind": "word",
          "ru": "Мама",
          "thai": "แม่",
          "phonetic": "мэ↘",
          "tip": "Повтори с разными эмоциями — так липнет."
        },
        {
          "order": 3,
          "kind": "word",
          "ru": "Папа",
          "thai": "พ่อ",
          "phonetic": "пхо↘",
          "tip": "Свяжи с картинкой в голове."
        },
        {
          "order": 4,
          "kind": "word",
          "ru": "Брат сестра",
          "thai": "พี่น้อง",
          "phonetic": "пхи→ нонг→",
          "tip": "Сначала тон, потом скорость."
        },
        {
          "order": 5,
          "kind": "phrase",
          "ru": "У меня есть мама",
          "thai": "ฉันมีแม่",
          "phonetic": "чхан→ ми→ мэ↘",
          "tip": "«У меня есть мама» — повтори 2 раза: медленно → как местный."
        },
        {
          "order": 6,
          "kind": "phrase",
          "ru": "Моя семья в России",
          "thai": "ครอบครัวฉันอยู่รัสเซีย",
          "phonetic": "кхроп→ кхруа→ чхан→ ю→ рас→ сиа→",
          "tip": "Закрой RU и вспомни только по ситуации."
        },
        {
          "order": 7,
          "kind": "phrase",
          "ru": "Сколько братьев сестёр?",
          "thai": "คุณมีพี่น้องกี่คน",
          "phonetic": "кун→ ми→ пхи→ нонг→ ги→ кон↗",
          "tip": "Спрашивай цену спокойно — торг начинается после ответа."
        },
        {
          "order": 8,
          "kind": "phrase",
          "ru": "У меня один брат",
          "thai": "ฉันมีพี่ชายหนึ่งคน",
          "phonetic": "чхан→ ми→ пхи→ чай→ нынг→ кон→",
          "tip": "Запомни мелодией целиком, не по слогам."
        },
        {
          "order": 9,
          "kind": "casual",
          "ru": "Моя сестра",
          "thai": "น้องสาวฉัน",
          "phonetic": "нонг→ сао→ чхан→",
          "tip": "Casual: ок с друзьями, с незнакомцем — вежливее."
        },
        {
          "order": 10,
          "kind": "phrase",
          "ru": "Твоя мама готовит вкусно?",
          "thai": "แม่คุณทำอาหารอร่อยไหม",
          "phonetic": "мэ→ кун→ там→ а→ хаан→ а→ рой→ май↗",
          "tip": "Вопрос: в конце тон чуть [[вверх]]."
        }
      ]
    },
