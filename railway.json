{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "scripts/thai_tone_assessment/Dockerfile",
    "watchPatterns": [
      "scripts/thai_tone_assessment/**",
      "scripts/thai_taika_phonetic.py",
      "steps.json",
      "railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
